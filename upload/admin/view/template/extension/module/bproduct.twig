{{ header }}{{ column_left }}
<div id="content">
	<link rel="stylesheet" href="view/stylesheet/bproduct/settings.css">

	<div class="page-header">
		<div class="container-fluid">
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>

	<div class="container-fluid">
		{% if error_warning %}
		<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
			<button type="button" class="close" data-dismiss="alert">&times;</button>
		</div>
		{% endif %}

		<div id="bps-root" class="bps"
			data-save="{{ action }}"
			data-unsaved="{{ text_unsaved|e('html_attr') }}"
			data-fail="{{ text_request_failed|e('html_attr') }}"
			data-denied="{{ error_permission|e('html_attr') }}">

			<div class="bps-ph">
				<div><h1>{{ heading_title2 }} <span class="bps-pill bps-pill-inline">{{ text_build }} · v{{ version }}</span></h1><p>{{ text_subtitle }}</p></div>
				<div class="bps-acts">
					<span class="bps-un" id="bps-un" hidden><i class="fa fa-exclamation-circle"></i> {{ text_unsaved }}</span>
					<a href="{{ manager }}" class="btn btn-default"><i class="fa fa-bolt"></i> {{ text_open }}</a>
					<button type="button" id="bps-save" class="btn btn-primary" disabled><i class="fa fa-check"></i> {{ button_save }}</button>
				</div>
			</div>

			<div class="bps-lay">
				<nav class="bps-sn" role="tablist">
					<div class="bps-sg">{{ nav_settings }}</div>
					<a href="#bps-general" data-bps-tab="general" class="bps-snav bps-on"><i class="fa fa-sliders"></i> {{ tab_general }}</a>
					<a href="#bps-barcode" data-bps-tab="barcode" class="bps-snav"><i class="fa fa-barcode"></i> {{ tab_barcode }}</a>
					<a href="#bps-category" data-bps-tab="category" class="bps-snav"><i class="fa fa-sitemap"></i> {{ tab_category }}</a>
					<div class="bps-sg">{{ nav_list }}</div>
					<a href="#bps-columns" data-bps-tab="columns" class="bps-snav"><i class="fa fa-table"></i> {{ tab_columns }}</a>
					<div class="bps-sg">{{ nav_editor }}</div>
					<a href="#bps-tabs" data-bps-tab="tabs" class="bps-snav"><i class="fa fa-columns"></i> {{ tab_editor }}</a>
				</nav>

				<main class="bps-main">
					<form id="form-module" onsubmit="return false;">

					<div class="bps-pane bps-on" id="bps-general">
						<div class="bps-card">
							<div class="bps-card-h"><h3>{{ text_edit }}</h3></div>
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ entry_status }}</b><small>{{ help_status }}</small></div>
								<div class="bps-row-r"><label class="bps-sw"><input type="checkbox" data-bps-field name="module_bproduct_status" value="1" {% if module_bproduct_status %}checked{% endif %}><span></span></label></div>
							</div>
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ entry_limit }}</b><small>{{ help_limit }}</small></div>
								<div class="bps-row-r">
									<select class="form-control" data-bps-field name="module_bproduct_limit">
										{% for limit in limits %}
										<option value="{{ limit }}" {{ limit == module_bproduct_limit ? 'selected="selected"' : '' }}>{{ limit }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ entry_sort }}</b></div>
								<div class="bps-row-r">
									<select class="form-control" data-bps-field name="module_bproduct_sort">
										{% for sort in sorts %}
										<option value="{{ sort.value }}" {{ sort.value == module_bproduct_sort ? 'selected="selected"' : '' }}>{{ sort.text }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ entry_new_status }}</b><small>{{ help_new_status }}</small></div>
								<div class="bps-row-r"><label class="bps-sw"><input type="checkbox" data-bps-field name="module_bproduct_new_status" value="1" {% if module_bproduct_new_status %}checked{% endif %}><span></span></label></div>
							</div>
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ entry_drawer_width }}</b><small>{{ help_drawer_width }}</small></div>
								<div class="bps-row-r"><div class="input-group"><input type="number" class="form-control" data-bps-field name="module_bproduct_drawer_width" min="600" max="1600" step="10" value="{{ module_bproduct_drawer_width }}"><span class="input-group-addon">px</span></div></div>
							</div>
						</div>
					</div>

					<div class="bps-pane" id="bps-barcode">
						<div class="bps-card">
							<div class="bps-card-h"><h3>{{ text_barcode }}</h3></div>
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ entry_barcode_status }}</b><small>{{ help_barcode_status }}</small></div>
								<div class="bps-row-r"><label class="bps-sw"><input type="checkbox" data-bps-field name="module_bproduct_barcode_status" value="1" {% if module_bproduct_barcode_status %}checked{% endif %}><span></span></label></div>
							</div>
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ entry_barcode_front }}</b><small>{{ help_barcode_front }}</small></div>
								<div class="bps-row-r"><label class="bps-sw"><input type="checkbox" data-bps-field name="module_bproduct_barcode_front" value="1" {% if module_bproduct_barcode_front %}checked{% endif %}><span></span></label></div>
							</div>
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ entry_barcode_source }}</b><small>{{ help_barcode_source }}</small></div>
								<div class="bps-row-r">
									<select class="form-control" data-bps-field name="module_bproduct_barcode_source">
										{% for source in barcode_sources %}
										<option value="{{ source.value }}" {{ source.value == module_bproduct_barcode_source ? 'selected="selected"' : '' }}>{{ source.text }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
						</div>
					</div>

					<div class="bps-pane" id="bps-category">
						<div class="bps-card">
							<div class="bps-card-h"><h3>{{ text_category }}</h3></div>
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ entry_category_status }}</b><small>{{ help_category_status }}</small></div>
								<div class="bps-row-r"><label class="bps-sw"><input type="checkbox" data-bps-field name="module_bproduct_category_status" value="1" {% if module_bproduct_category_status %}checked{% endif %}><span></span></label></div>
							</div>
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ entry_category_display }}</b><small>{{ help_category_display }}</small></div>
								<div class="bps-row-r"><label class="bps-sw"><input type="checkbox" data-bps-field name="module_bproduct_category_display" value="1" {% if module_bproduct_category_display %}checked{% endif %}><span></span></label></div>
							</div>
						</div>
					</div>

					<div class="bps-pane" id="bps-columns">
						<div class="bps-card">
							<div class="bps-card-h"><h3>{{ text_columns }}</h3></div>
							<p class="bps-lead">{{ text_columns_desc }}</p>
							{% for column in columns %}
							<div class="bps-row">
								<div class="bps-row-l"><b>{{ column.text }}</b></div>
								<div class="bps-row-r"><label class="bps-sw"><input type="checkbox" data-bps-field name="module_bproduct_columns[{{ column.key }}]" value="1" {% if column.shown %}checked{% endif %}><span></span></label></div>
							</div>
							{% endfor %}
						</div>
					</div>

					<div class="bps-pane" id="bps-tabs">
						<div class="bps-card">
							<div class="bps-card-h"><h3>{{ text_tabs }}</h3></div>
							<p class="bps-lead">{{ text_tabs_desc }}</p>
							<ul id="bps-tab-list" class="bps-sort">
								{% for tab in tabs %}
								<li draggable="true">
									<i class="fa fa-bars bps-handle"></i>
									<span class="bps-tname">{{ tab.text }}</span>
									<input type="hidden" data-bps-field name="module_bproduct_tab_order[]" value="{{ tab.key }}">
									{% if tab.required %}
									<span class="bps-lock"><i class="fa fa-lock"></i></span>
									{% else %}
									<label class="bps-sw"><input type="checkbox" data-bps-field name="module_bproduct_tabs[{{ tab.key }}]" value="1" {% if tab.shown %}checked{% endif %}><span></span></label>
									{% endif %}
								</li>
								{% endfor %}
							</ul>
						</div>
					</div>

					</form>
				</main>
			</div>

			<div class="bps-foot">
				<span class="bps-un" id="bps-un-foot" hidden><i class="fa fa-exclamation-circle"></i> {{ text_unsaved }}</span>
				<button type="button" id="bps-save-foot" class="btn btn-primary" title="Ctrl + S" disabled><i class="fa fa-check"></i> {{ button_save }}</button>
			</div>
		</div>
	</div>
</div>
<script src="view/javascript/bproduct/settings.js"></script>
{{ footer }}
