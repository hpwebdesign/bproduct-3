  var h = '<div class="note">' + ic('globe', 15) + '<span>' + esc(T.bc_seo_hint) + '</span></div>';
  CFG.stores.forEach(function (s) {
    h += '<div class="f"><label>' + esc(T.bc_entry_keyword) + (CFG.stores.length > 1 ? ' <small style="display:inline;font-weight:400">· ' + esc(s.name) + '</small>' : '') + '</label>';
    CFG.languages.forEach(function (l) {
      var v = (c.seo[s.store_id] && c.seo[s.store_id][l.language_id]) || '';
      h += '<div class="seo">' + (multiLang() ? langBadge(l) : '') + '<span class="mono pre">/</span><input class="inp mono sm" data-seo="' + s.store_id + '|' + l.language_id + '" value="' + esc(v) + '" placeholder="' + esc(T.bc_entry_keyword) + '"><button type="button" class="btn ghost sm" data-act="seogen" data-sid="' + s.store_id + '" data-lid="' + l.language_id + '">' + esc(T.bc_generate) + '</button></div><div class="slugmsg" data-seomsg="' + s.store_id + '|' + l.language_id + '" style="margin:0 0 10px ' + (multiLang() ? '34' : '0') + 'px"></div>';
    });
    h += '</div>';
  });
  return h;
}
function collectSeo() {
  var kw = {};
  $$('[data-seo]').forEach(function (e) {
    var a = e.dataset.seo.split('|');
    kw[a[0]] = kw[a[0]] || {}; kw[a[0]][a[1]] = e.value.trim();
  });
  return {keywords: kw};
}
var seoTimers = {};
function seoCheck(inp, auto) {
  kwMirror(inp);
  var key = inp.dataset.seo, a = key.split('|'), m = $('[data-seomsg="' + key + '"]'), v = inp.value.trim();
  if (!v) { m.className = 'slugmsg'; m.textContent = ''; return Promise.resolve(true); }
  var dup = $$('[data-seo^="' + a[0] + '|"]').some(function (o) { return o !== inp && o.value.trim() === v; });
  if (dup) { m.className = 'slugmsg bad'; m.textContent = T.bc_error_unique; return Promise.resolve(false); }
  return api('seo', {keyword: v, store_id: a[0], category_id: DR ? DR.id : 0}).then(function (j) {
    if (j.ok) { m.className = 'slugmsg ok'; m.textContent = '✓ ' + T.bc_available; return true; }
    if (auto && j.suggest) { inp.value = j.suggest; return seoCheck(inp); }
    m.className = 'slugmsg bad'; m.textContent = T.bc_error_keyword + ' ' + fmt(T.bc_try, j.suggest);
    return false;
  }).catch(function () { return true; });
}
function designBody(c) {
  return '<table class="dsg"><thead><tr><th>' + esc(T.bc_entry_store) + '</th><th>' + esc(T.bc_entry_layout) + '</th></tr></thead><tbody>' + CFG.stores.map(function (s) {
    return '<tr><td>' + esc(s.name) + '</td><td><select class="inp" data-lay="' + s.store_id + '"><option value=""></option>' + CFG.layouts.map(function (l) { return '<option value="' + l.id + '" ' + (String(c.layouts[s.store_id]) === String(l.id) ? 'selected' : '') + '>' + esc(l.name) + '</option>'; }).join('') + '</select></td></tr>';
  }).join('') + '</tbody></table>';
}
function collectDesign() {
  var o = {};
  $$('[data-lay]').forEach(function (e) {
    var had = DR.c.layouts[e.dataset.lay] !== undefined;
    if (e.value || had) o[e.dataset.lay] = e.value ? +e.value : 0;
  });
  return {layouts: o};
}

/* ---------- edit drawer ---------- */
function secBody(k, c) {
  switch (k) {
    case 'general': return generalBody(c);
    case 'data': return dataBody(c);
    case 'seo': return seoBody(c);
    case 'design': return designBody(c);
  }
  return '';
}
function drawerOpen(narrow) {
  var d = $('#drawer');
  d.classList.remove('wide'); d.classList.toggle('narrow', !!narrow);
  d.classList.add('on'); $('#drawBack').classList.add('on');
}
function openDrawer(id, sec, focusDn) {
  DR = {mode: 'edit', id: id, sec: sec, dirty: {}, loaded: false, focusDn: !!focusDn};
  var tabs = SECS.map(function (s) { return '<button type="button" data-act="tab" data-sec="' + s[0] + '" class="' + (s[0] === sec ? 'on' : '') + '">' + ic(s[2]) + '<span>' + esc(T[s[1]]) + '</span></button>'; }).join('');
  $('#drawer').innerHTML = '<div class="dh"><span class="addic">' + ic('folder', 20) + '</span><div><b>&nbsp;</b><small>&nbsp;</small></div><button type="button" class="btn ghost sm" style="margin-left:auto" data-act="fullform" data-id="' + id + '" title="' + esc(T.bc_full_form_hint) + '">' + ic('ext', 14) + ' ' + esc(T.bc_full_form) + '</button><button type="button" class="btn ghost icon" data-act="dclose" aria-label="' + esc(T.button_close) + '">' + ic('x') + '</button></div>' +
    '<div class="dm"><div class="tabs">' + tabs + '</div><div class="db"><div class="skel" style="width:60%"></div><div class="skel"></div><div class="skel" style="width:80%"></div></div></div>' +
    '<div class="df"><span class="un" id="undirty">' + ic('alert') + ' ' + esc(T.bc_unsaved) + '</span><span class="sv"></span><span class="kbd">' + KBD + '</span><button type="button" class="btn ghost" data-act="dclose">' + esc(T.button_cancel) + '</button><button type="button" class="btn primary needmod" data-act="dsave">' + ic('check') + ' ' + esc(T.button_save) + '</button></div>';
  drawerOpen(false);
  api('category', {category_id: id}).then(function (j) {
    if (!DR || DR.id !== id || DR.mode !== 'edit') return;
    if (j.error) { toast(j.error, 'err'); closeDrawer(true); return; }
    fillDrawer(j.category);
  }).catch(function (e) { fail(e); closeDrawer(true); });
}
function fillDrawer(c) {
  DR.c = c; DR.loaded = true;
  DR.parent = c.parent; DR.stores = c.stores.slice(); DR.filters = c.filters.slice(); DR.extra = (c.extra_parents || []).slice(); DR.image = c.image.path ? {path: c.image.path, thumb: c.image.thumb} : null;
  $('.db').innerHTML = SECS.map(function (s) { return '<div class="sec ' + (s[0] === DR.sec ? 'on' : '') + '" data-s="' + s[0] + '">' + secBody(s[0], c) + '</div>'; }).join('');
  ssLabel('dparent'); chipsPaint(); imgPaint('#d-img', DR.image);
  $$('.lp').forEach(dnPreview);
  $$('[data-seo]').forEach(function (e) { if (e.value.trim()) seoCheck(e); });
  headRefresh();
  if (DR.focusDn) {
    var inp = $('.lp.on [data-k="display"]') || $('.lp [data-k="display"]');
    if (inp) { inp.focus(); inp.select(); }
  }
}
function headRefresh() {
  var nm = $('.lp[data-lid="' + CFG.language_id + '"] [data-k="name"]') || $('.lp [data-k="name"]');
  var kw = $('[data-seo="0|' + CFG.language_id + '"]');
  var b = $('.dh b'), s = $('.dh small');
  if (b && nm) b.textContent = nm.value.trim() || ' ';
  if (s) s.textContent = kw && kw.value.trim() ? '/' + kw.value.trim() : '/' + T.bc_no_slug;
}
function closeDrawer(force) {
  if (!force && DR && isDirty()) {
    askConfirm(T.bc_discard_title, T.bc_discard_text, T.bc_discard, function () { closeDrawer(true); });
    return;
  }
  $('#drawer').classList.remove('on'); $('#drawBack').classList.remove('on'); DR = null;
}

/* ---------- save ---------- */
function collect(sec) {
  switch (sec) {
    case 'general': return collectGeneral();
    case 'data': return collectData();
    case 'seo': return collectSeo();
    case 'design': return collectDesign();
  }
  return null;
}
function clearErrors() {
  $$('.errtxt[data-e]').forEach(function (e) { e.textContent = ''; });
  $$('.inp.err').forEach(function (e) { e.classList.remove('err'); });
}
function applyErrors(err) {
  clearErrors();
  var first = null;
  function mark(sec, node, msg) {
    if (node) { node.classList.add('err'); var e = node.parentNode.querySelector('.errtxt[data-e]'); if (e) e.textContent = msg; }
    if (!first) first = {sec: sec, node: node};
  }
  ['name', 'meta_title', 'display'].forEach(function (k) {
    if (err[k]) Object.keys(err[k]).forEach(function (lid) {
      var pn = $('.lp[data-lid="' + lid + '"]'), node = pn ? pn.querySelector('[data-k="' + (k === 'display' ? 'display' : k) + '"]') : null;
      mark('general', node, err[k][lid]);
      if (pn && first && first.sec === 'general' && !first.lid) first.lid = lid;
    });
  });
  if (err.parent) { var pe = $('.sec[data-s="data"] .errtxt[data-e="parent"]'); if (pe) pe.textContent = err.parent; if (!first) first = {sec: 'data', node: null}; }
  if (err.keyword) Object.keys(err.keyword).forEach(function (sid) {
    Object.keys(err.keyword[sid]).forEach(function (lid) {
      var inp = $('[data-seo="' + sid + '|' + lid + '"]'), m = $('[data-seomsg="' + sid + '|' + lid + '"]');
      if (inp) inp.classList.add('err');
      if (m) { m.className = 'slugmsg bad'; m.textContent = err.keyword[sid][lid]; }
      if (!first) first = {sec: 'seo', node: inp};
    });
  });
  if (first) {
    gotoTab(first.sec);
    if (first.sec === 'general' && first.lid) { var lb = $('.lang [data-lid="' + first.lid + '"]'); if (lb) lb.click(); }
    if (first.node) first.node.focus();
  }
}
function saveDrawer() {
  if (!DR || !DR.loaded || !isDirty()) { if (DR && DR.loaded) toast(T.bc_nothing_to_save); return; }
  var secs = Object.keys(DR.dirty);
  clearErrors();
  if (secs.indexOf('general') >= 0) {
    checkLang();
    var bad = $$('.lp').filter(function (pn) { return !pn.querySelector('[data-k="name"]').value.trim() || !pn.querySelector('[data-k="meta_title"]').value.trim(); })[0];
    if (bad) {
      gotoTab('general'); var lb = $('.lang [data-lid="' + bad.dataset.lid + '"]'); if (lb) lb.click();
      ['name', 'meta_title'].forEach(function (k) { var n = bad.querySelector('[data-k="' + k + '"]'); if (!n.value.trim()) { n.classList.add('err'); n.parentNode.querySelector('.errtxt').textContent = T[k === 'name' ? 'bc_error_name' : 'bc_error_meta_title']; } });
      toast(T.bc_required_all_langs, 'err'); return;
    }
  }
  var sections = {};
  secs.forEach(function (k) { sections[k] = collect(k); });
  var id = DR.id, btn = $('[data-act="dsave"]');
  btn.disabled = true;
  api('save', null, {category_id: id, sections: sections}).then(function (j) {
    btn.disabled = false;
    if (!DR || DR.id !== id) return;
    if (j.error) {
      if (typeof j.error === 'string') { toast(j.error, 'err'); return; }
      applyErrors(j.error); toast(j.error.warning || T.bc_error_server, 'err'); return;
    }
    clearDirty();
    S.stats = j.stats;
    headRefresh();
    toast(j.success);
    if (secs.indexOf('data') >= 0) load(); else { replaceRow(j.row); render(); }
  }).catch(function (e) { btn.disabled = false; fail(e); });
}

