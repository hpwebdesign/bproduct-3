function addSave(mode) {
  if (!CFG.can_modify) { toast(T.bc_error_permission, 'err'); return; }
  var name = $('#a-name').value.trim();
  $('#e-name').textContent = ''; $('#e-parent').textContent = ''; $('#a-name').classList.remove('err');
  if (!name) { $('#e-name').textContent = T.bc_error_name; $('#a-name').classList.add('err'); $('#a-name').focus(); toast(T.bc_fix_fields, 'err'); return; }
  $$('[data-act="addsave"]').forEach(function (b) { b.disabled = true; });
  api('add', null, {name: name, display_name: $('#a-display').value.trim(), parent_id: DR.parent ? DR.parent.id : 0, image: DR.image ? DR.image.path : '', status: $('#a-stat').checked ? 1 : 0}).then(function (j) {
    $$('[data-act="addsave"]').forEach(function (b) { b.disabled = false; });
    if (j.error) {
      if (typeof j.error === 'string') { toast(j.error, 'err'); return; }
      if (j.error.name) { $('#e-name').textContent = j.error.name; $('#a-name').classList.add('err'); }
      if (j.error.parent) { $('#e-parent').textContent = j.error.parent; }
      toast(j.error.warning || T.bc_error_server, 'err'); return;
    }
    S.q = ''; S.status = ''; S.parent = null; $('#q').value = ''; ssLabel('fparent');
    S.page = 1; S.flash = j.category_id;
    closeDrawer(true);
    load(true);
    if (mode === 'edit') { openDrawer(j.category_id, 'general'); toast(T.bc_added_edit); }
    else toast(j.success);
  }).catch(function (e) { $$('[data-act="addsave"]').forEach(function (b) { b.disabled = false; }); fail(e); });
}

/* ---------- events ---------- */
var MODACTS = ['addopen', 'del', 'bulk-del', 'bulk-en', 'bulk-dis', 'bulk-top', 'bulkpick', 'bppick', 'dsave', 'addsave', 'tog', 'slugauto'];
function denied(a) {
  if (CFG.can_modify || MODACTS.indexOf(a) < 0) return false;
  toast(T.bc_error_permission, 'err');
  return true;
}
R.addEventListener('click', function (e) {
  var t = e.target;
  if (!t.closest('.ss')) ssCloseAll();
  if (!t.closest('.ac')) $$('.acl.on').forEach(function (x) { x.classList.remove('on'); });
  if (!t.closest('#pop,[data-act="bulkpick"]')) closeFloat();
  var tr = t.closest('tr.row');
  if (tr && !t.closest('a,button,input,label,select,textarea,[data-act]')) { openDrawer(+tr.dataset.id, 'general'); return; }
  var ed = t.closest('[data-ed]');
  if (ed) { edRun(ed); return; }
  var el = t.closest('[data-act]');
  if (!el || (el.matches('input') && el.type !== 'button')) return;
  var a = el.dataset.act, id = el.dataset.id ? +el.dataset.id : null;
  if (denied(a)) return;
  switch (a) {
    case 'sort': S.sort = el.dataset.sort; S.order = el.dataset.order; S.page = 1; load(); break;
    case 'stf': S.status = el.dataset.s; S.page = 1; load(); break;
    case 'pg': if (+el.dataset.p >= 1) { S.page = +el.dataset.p; window.scrollTo({top: 0, behavior: 'smooth'}); load(); } break;
    case 'reset': resetAll(); break;
    case 'addopen': if (!isDirty() || !DR) openAdd(); break;
    case 'del': { var r = rowById(id); deleteIds([id], r ? r.leaf : ''); break; }
    case 'bulk-del': deleteIds(Array.from(S.sel)); break;
    case 'bulk-en': case 'bulk-dis': setStatus(Array.from(S.sel), a === 'bulk-en' ? 1 : 0); break;
    case 'bulk-top': if (S.sel.size) bulkRequest({action: 'top', value: +el.dataset.v}); break;
    case 'bulk-clear': S.sel.clear(); render(); break;
    case 'bulkpick': openBulkPick(el); break;
    case 'bppick': applyBulkPick(+el.dataset.id); break;
    case 'popclose': case 'menuclose': closeFloat(); break;
    case 'sec': openDrawer(id, el.dataset.sec); break;
    case 'dn': openDrawer(id, 'general', true); break;
    case 'fullform': window.open(CFG.edit_url + id, '_blank'); break;
    case 'slugauto': slugGenerate(id); break;
    case 'slugcopy': { var q = rowById(id); if (q && navigator.clipboard) navigator.clipboard.writeText(CFG.catalog_url + '/' + q.slug); toast(T.bc_slug_copied); break; }
    case 'storefront': { var sp = rowById(id); window.open(sp && sp.slug ? CFG.catalog_url + '/' + sp.slug : CFG.storefront_url + id, '_blank'); break; }
    case 'ssopen': {
      var w = el.closest('.ss'), was = w.classList.contains('open');
      ssCloseAll();
      if (!was) { w.classList.add('open'); ssFill(el.dataset.ss, ''); var sq = w.querySelector('[data-ssq]'); sq.value = ''; sq.focus(); }
      break;
    }
    case 'sspick': {
      var nm = el.dataset.ss, c = SSCFG[nm], item = el.dataset.id ? byKey(ssCache[nm] || [], 'id', el.dataset.id) : null;
      c.set(item ? {id: item.id, name: item.name} : null); ssLabel(nm); ssCloseAll(); c.after();
      break;
    }
    case 'cf-no': $('#cf').classList.remove('on'); cfCb = null; break;
    case 'cf-yes': { $('#cf').classList.remove('on'); var cb = cfCb; cfCb = null; if (cb) cb(); break; }
    case 'dclose': closeDrawer(); break;
    case 'dsave': saveDrawer(); break;
    case 'tab': {
      $$('.tabs button').forEach(function (b) { b.classList.toggle('on', b === el); });
      $$('.sec').forEach(function (s) { s.classList.toggle('on', s.dataset.s === el.dataset.sec); });
      break;
    }
    case 'lang': {
      el.parentNode.querySelectorAll('button').forEach(function (b) { b.classList.toggle('on', b === el); });
      $$('.lp').forEach(function (x) { x.classList.toggle('on', x.dataset.lid === el.dataset.lid); });
      break;
    }
    case 'acpick': {
      var kind = el.closest('.ac').querySelector('input').dataset.ac, list = kind === 'extra' ? DR.extra : DR.filters;
      var it = (ACI[kind] || [])[+el.dataset.i]; if (!it) break;
      if (list.some(function (x) { return x.id === it.id; })) { toast(T.bc_already_added); break; }
      list.push({id: it.id, name: it.name}); chipsPaint(); markDirty('data');
      var ai = el.closest('.ac').querySelector('input'); ai.value = ''; $$('.acl.on').forEach(function (x) { x.classList.remove('on'); });
      break;
    }
    case 'rmchip': if (el.dataset.kind === 'extra') { DR.extra = DR.extra.filter(function (x) { return x.id !== id; }); } else { DR.filters = DR.filters.filter(function (x) { return x.id !== id; }); } chipsPaint(); markDirty('data'); break;
    case 'dimg': pickImage(function (path, thumb) { DR.image = {path: path, thumb: thumb}; imgPaint('#d-img', DR.image); markDirty('data'); }, el, function () { DR.image = null; imgPaint('#d-img', null); markDirty('data'); }); break;
    case 'dimgrm': DR.image = null; imgPaint('#d-img', null); markDirty('data'); break;
    case 'addimg': pickImage(function (path, thumb) { DR.image = {path: path, thumb: thumb}; imgPaint('#a-img', DR.image); markDirty(); }, el, function () { DR.image = null; imgPaint('#a-img', null); markDirty(); }); break;
    case 'addsave': addSave(el.dataset.mode); break;
    case 'seogen': {
      var inp = $('[data-seo="' + el.dataset.sid + '|' + el.dataset.lid + '"]'), nmi = $('.lp[data-lid="' + el.dataset.lid + '"] [data-k="name"]');
      if (inp && nmi) { inp.value = slugify(nmi.value); markDirty('seo'); seoCheck(inp, true); headRefresh(); }
      break;
    }
  }
});

/* filter autocomplete */
var ACI = {}, acTok = 0;
var acShow = debounce(function (inp) {
  var q = inp.value.trim(), box = inp.parentNode.querySelector('.acl'), tok = ++acTok, kind = inp.dataset.ac;
  box.innerHTML = '<div class="aci" style="color:var(--mute);cursor:default">' + esc(T.text_loading) + '</div>'; box.classList.add('on');
  api('ac', kind === 'extra' ? {type: 'category', q: q, exclude: DR ? DR.id : ''} : {type: 'filter', q: q}).then(function (j) {
    if (tok !== acTok) return;
    ACI[kind] = j.items || [];
    var h = '';
    ACI[kind].forEach(function (o, i) {
      var used = DR && (kind === 'extra' ? DR.extra : DR.filters).some(function (x) { return x.id === o.id; });
      h += '<div class="aci" data-act="acpick" data-i="' + i + '"><span>' + hl(o.name, q) + '</span>' + (used ? '<span class="bdg g" style="margin-left:auto">' + esc(T.bc_added) + '</span>' : '') + '</div>';
    });
    box.innerHTML = h || '<div class="aci" style="color:var(--mute);cursor:default">' + esc(T.bc_no_match) + '</div>';
  }).catch(fail);
}, 200);

R.addEventListener('change', function (e) {
  var el = e.target, d = el.dataset;
  if (d.act === 'tog' && denied('tog')) { el.checked = !el.checked; return; }
  if (d.act === 'tog') { setStatus([+d.id], el.checked ? 1 : 0, el); return; }
  if (d.act === 'selrow') { el.checked ? S.sel.add(+d.id) : S.sel.delete(+d.id); render(); return; }
  if (d.act === 'selall') { S.rows.forEach(function (c) { el.checked ? S.sel.add(c.category_id) : S.sel.delete(c.category_id); }); render(); return; }
  if (d.act === 'per') { S.per = +el.value; S.page = 1; load(); return; }
