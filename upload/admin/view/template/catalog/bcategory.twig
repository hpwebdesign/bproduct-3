file:'<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
globe:'<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
box:'<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>',
layout:'<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>',
sort:'<polyline points="8 9 12 5 16 9"/><polyline points="16 15 12 19 8 15"/>',
info:'<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>',
alert:'<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>'
};
var KBD = /Mac|iPhone|iPad/i.test(navigator.platform || navigator.userAgent) ? '⌘ + S' : 'Ctrl + S';
function ic(n, s) { return '<svg class="i" viewBox="0 0 24 24"' + (s ? ' style="width:' + s + 'px;height:' + s + 'px"' : '') + '>' + ICONS[n] + '</svg>'; }
function $(s) { return R.querySelector(s); }
function $$(s) { return Array.prototype.slice.call(R.querySelectorAll(s)); }
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]; }); }
function hl(t, q) {
  t = String(t);
  if (!q) return esc(t);
  var i = t.toLowerCase().indexOf(q.toLowerCase());
  return i < 0 ? esc(t) : esc(t.slice(0, i)) + '<mark>' + esc(t.slice(i, i + q.length)) + '</mark>' + esc(t.slice(i + q.length));
}
function slugify(s) {
  return String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}
function fmt(str) {
  var a = Array.prototype.slice.call(arguments, 1), i = 0;
  return String(str).replace(/%[sd]/g, function () { return a[i++]; });
}
function debounce(fn, ms) {
  var t;
  return function () {
    var a = arguments, self = this;
    clearTimeout(t);
    t = setTimeout(function () { fn.apply(self, a); }, ms);
  };
}
function byKey(list, key, id) {
  for (var i = 0; i < list.length; i++) if (String(list[i][key]) === String(id)) return list[i];
  return null;
}

/* ---------- api ---------- */
function api(bc, params, body) {
  var url = CFG.endpoint + bc;
  if (params) {
    Object.keys(params).forEach(function (k) {
      if (params[k] !== undefined && params[k] !== null && params[k] !== '') url += '&' + k + '=' + encodeURIComponent(params[k]);
    });
  }
  var opt = {credentials: 'same-origin'};
  if (body) {
    opt.method = 'POST';
    opt.headers = {'Content-Type': 'application/json'};
    opt.body = JSON.stringify(body);
  }
  return fetch(url, opt).then(function (r) { return r.text(); }).then(function (t) {
    try { return JSON.parse(t); } catch (e) { throw new Error(T.bc_error_server); }
  });
}
function fail(e) { toast(e && e.message ? e.message : T.bc_error_server, 'err'); }

/* ---------- toast / confirm ---------- */
function toast(msg, type) {
  var t = document.createElement('div');
  t.className = 'toast ' + (type || '');
  t.innerHTML = (type === 'err' ? ic('alert') : ic('check')) + '<span></span>';
  t.lastChild.textContent = msg;
  $('#toasts').appendChild(t);
  setTimeout(function () { t.remove(); }, type === 'err' ? 5200 : 3200);
}
var cfCb = null;
function askConfirm(title, text, label, cb) {
  $('#cf-t').textContent = title;
  $('#cf-p').textContent = text;
  $('#cf-yes').textContent = label;
  cfCb = cb;
  $('#cf').classList.add('on');
}

/* ---------- state ---------- */
var S = {sort: 'name', order: 'ASC', q: '', status: '', parent: null, per: CFG.limit, page: 1, sel: new Set(), rows: [], total: 0, pages: 1, stats: null, flash: null, loaded: false};
var DR = null;
var reqId = 0;

/* ---------- list loading ---------- */
function listParams() {
  return {page: S.page, limit: S.per, sort: S.sort, order: S.order, q: S.q.trim(), status: S.status, parent_id: S.parent ? S.parent.id : ''};
}
function busy(on) {
  var c = $('#listcard');
  c.classList.toggle('loading', on);
  if (on) c.setAttribute('aria-busy', 'true'); else c.removeAttribute('aria-busy');
}
function load(keepFlash) {
  var id = ++reqId;
  busy(true);
  return api('list', listParams()).then(function (j) {
    if (id !== reqId) return;
    busy(false);
    if (j.error) { toast(j.error, 'err'); return; }
    S.rows = j.categories; S.total = j.total; S.page = j.page; S.pages = j.pages; S.stats = j.stats; S.loaded = true;
    if (!keepFlash) S.flash = null;
    render();
  }).catch(function (e) { if (id === reqId) { busy(false); fail(e); } });
}
var loadSoon = debounce(function () { load(); }, 280);

/* ---------- searchable select (parent) ---------- */
var SSCFG = {
  fparent: {all: T.bc_all_parents, get: function () { return S.parent; }, set: function (v) { S.parent = v; }, after: function () { S.page = 1; load(); }},
  dparent: {all: T.bc_top_level, get: function () { return DR ? DR.parent : null; }, set: function (v) { DR.parent = v; }, after: function () { markDirty('data'); }},
  aparent: {all: T.bc_top_level, get: function () { return DR ? DR.parent : null; }, set: function (v) { DR.parent = v; }, after: function () { markDirty(); }}
};
function ssHtml(n) {
  return '<div class="ss" data-ss="' + n + '"><button type="button" class="inp ssb" data-act="ssopen" data-ss="' + n + '"><span class="ssv"></span>' + ic('chev', 14) + '</button><div class="ssl"><input class="inp sm" data-ssq="' + n + '" placeholder="' + esc(T.bc_search) + '" autocomplete="off"><div class="sso" data-sso="' + n + '"></div></div></div>';
}
function ssLabel(n) {
  var c = SSCFG[n], v = c.get();
  $$('.ss[data-ss="' + n + '"] .ssv').forEach(function (el) { el.textContent = v ? v.name : c.all; el.classList.toggle('ph', !v); });
}
var ssCache = {};
function ssFill(n, q) {
  var c = SSCFG[n], v = c.get(), box = $('[data-sso="' + n + '"]');
  var head = q ? '' : '<div class="ssi ' + (!v ? 'sel' : '') + '" data-act="sspick" data-ss="' + n + '" data-id="">' + esc(c.all) + '</div>';
  box.innerHTML = head + '<div class="ssi none">' + esc(T.text_loading) + '</div>';
  api('ac', {type: 'category', q: q, exclude: n === 'dparent' && DR ? DR.id : ''}).then(function (j) {
    ssCache[n] = j.items || [];
    box.innerHTML = head + (ssCache[n].length ? ssCache[n].map(function (o) {
      return '<div class="ssi ' + (v && v.id === o.id ? 'sel' : '') + '" data-act="sspick" data-ss="' + n + '" data-id="' + o.id + '">' + hl(o.name, q) + '</div>';
    }).join('') : '<div class="ssi none">' + esc(T.bc_no_match) + '</div>');
  }).catch(fail);
}
function ssCloseAll() { $$('.ss.open').forEach(function (x) { x.classList.remove('open'); }); }
var ssSearch = debounce(function (n, q) { ssFill(n, q); }, 220);

/* ---------- list rendering ---------- */
var SORTS = {
  'name': {l: T.bc_column_name, asc: 'A–Z', desc: 'Z–A', first: 'ASC'},
  'display': {l: T.bc_display_name, asc: 'A–Z', desc: 'Z–A', first: 'ASC'},
  'products': {l: T.bc_column_products, asc: '0–9', desc: '9–0', first: 'DESC'},
  'sort_order': {l: T.bc_column_sort, asc: '0–9', desc: '9–0', first: 'ASC'},
  'status': {l: T.bc_column_status, asc: T.text_disabled, desc: T.text_enabled, first: 'DESC'}
};
function sortBtn(key) {
  var c = SORTS[key], on = S.sort === key, next = on ? (S.order === 'ASC' ? 'DESC' : 'ASC') : c.first;
  return '<button class="sorth ' + (on ? (S.order === 'ASC' ? 'asc' : 'desc') : 'off') + '" data-act="sort" data-sort="' + key + '" data-order="' + next + '">' + esc(c.l) + (on ? ' <span class="so">' + esc(c[S.order.toLowerCase()]) + '</span>' : '') + ic(on ? 'chev' : 'sort', 14) + '</button>';
}
function slugCell(c) {
  if (!c.slug) return '<div class="slug"><span class="bdg a">' + esc(T.bc_missing_seo) + '</span><button class="mini" data-act="slugauto" data-id="' + c.category_id + '" style="opacity:1;color:var(--blue);font-weight:600">' + esc(T.bc_generate) + '</button></div>';
  return '<div class="slug"><code title="' + esc(T.bc_slug_url) + '">/' + esc(c.slug) + '</code><button class="mini" data-act="slugcopy" data-id="' + c.category_id + '" title="' + esc(T.bc_copy) + '" aria-label="' + esc(T.bc_copy) + '">' + ic('copy', 13) + '</button><button class="mini" data-act="storefront" data-id="' + c.category_id + '" title="' + esc(T.bc_view_storefront) + '" aria-label="' + esc(T.bc_view_storefront) + '">' + ic('ext', 13) + '</button></div>';
}
function dnCell(c) {
  return '<div class="dncell">' + (c.display ? '<span class="dnt" title="' + esc(c.display) + '">' + esc(c.display) + '</span>' : '<span class="dnn">' + esc(T.bc_uses_category_name) + '</span>') +
    '<button type="button" class="btn blue icon sm" data-act="dn" data-id="' + c.category_id + '" title="' + esc(T.bc_edit_display_name) + '" aria-label="' + esc(T.bc_edit_display_name) + '">' + ic('edit', 14) + '</button></div>';
}
function rowHtml(c) {
  var id = c.category_id, cls = ['row'];
  if (S.flash === id) cls.push('flash');
  if (S.sel.has(id)) cls.push('sel');
  var lvl = Math.min(c.level, 6) * 18;
  return '<tr class="' + cls.join(' ') + '" data-id="' + id + '">' +
    '<td class="c-sel"><input type="checkbox" data-act="selrow" data-id="' + id + '" ' + (S.sel.has(id) ? 'checked' : '') + ' aria-label="' + esc(c.leaf) + '"></td>' +
    '<td class="c-name"><div class="cname' + (c.status ? '' : ' off') + '" style="padding-left:' + lvl + 'px"><span class="fi">' + ic('folder', 16) + '</span><div><b>' + esc(c.leaf) + (c.top ? ' <span class="topstar" title="' + esc(T.bc_top_marker) + '" aria-label="' + esc(T.bc_top_marker) + '">' + ic('star', 14) + '</span>' : '') + '</b><small>' + esc(c.path) + (c.status ? '' : ' <span class="bdg n">' + esc(T.text_disabled) + '</span>') + '</small>' + slugCell(c) + '</div></div></td>' +
    '<td class="c-dn" data-l="' + esc(T.bc_display_name) + '">' + dnCell(c) + '</td>' +
    '<td class="c-qty tn" data-l="' + esc(T.bc_column_products) + '">' + c.products + '</td>' +
    '<td class="c-qty tn" data-l="' + esc(T.bc_column_sort) + '">' + c.sort_order + '</td>' +
    '<td class="c-stat tc" data-l="' + esc(T.bc_column_status) + '"><label class="tg"><input type="checkbox" ' + (c.status ? 'checked' : '') + ' data-act="tog" data-id="' + id + '"><i></i></label></td>' +
    '<td class="c-act"><div class="acts"><button class="btn blue icon sq" data-act="sec" data-id="' + id + '" data-sec="general" title="' + esc(T.button_edit) + '" aria-label="' + esc(T.button_edit) + '">' + ic('edit') + '</button><button class="btn red icon sq" data-act="del" data-id="' + id + '" title="' + esc(T.button_delete) + '" aria-label="' + esc(T.button_delete) + '">' + ic('trash') + '</button></div></td>' +
    '</tr>';
}
function renderStats() {
  var s = S.stats;
  if (!s) { $('#stats').innerHTML = ''; return; }
  var pill = function (cls, icon, val, label) { return '<div class="st"><i class="ico ' + cls + ' bi bi-' + icon + '"></i><div><b>' + val + '</b><span>' + esc(label) + '</span></div></div>'; };
  $('#stats').innerHTML = pill('blue', 'folder2', s.total, T.bc_stat_total) + pill('green', 'check-circle', s.enabled, T.text_enabled) + pill('grey', 'slash-circle', s.total - s.enabled, T.text_disabled) + pill('amber', 'diagram-3', s.top, T.bc_stat_top) + pill('amber', 'exclamation-triangle', s.empty, T.bc_stat_empty);
}
function render() {
  var rows = S.rows, total = S.total, pages = S.pages;
  $('#thr').innerHTML = '<th><input type="checkbox" id="selall" data-act="selall"></th><th class="sortth">' + sortBtn('name') + '</th><th class="sortth">' + sortBtn('display') + ' <span class="bdg b">' + esc(T.bc_storefront) + '</span></th><th class="sortth tn">' + sortBtn('products') + '</th><th class="sortth tn">' + sortBtn('sort_order') + '</th><th class="sortth tc">' + sortBtn('status') + '</th><th></th>';
  $('#tbody').innerHTML = rows.map(rowHtml).join('');
  var filtered = S.q.trim() || S.status !== '' || S.parent;
  $('#emptybox').innerHTML = total ? '' : '<div class="empty"><b>' + esc(T.bc_no_results) + '</b>' + esc(filtered ? T.bc_no_results_filters : T.bc_no_results_empty) + (filtered ? '<div style="margin-top:12px"><button class="btn blue" data-act="reset">' + esc(T.bc_reset_all) + '</button></div>' : '') + '</div>';
  var arr = [];
  for (var i = 1; i <= pages; i++) { if (i === 1 || i === pages || Math.abs(i - S.page) <= 1) arr.push(i); else if (arr[arr.length - 1] !== '…') arr.push('…'); }
  var from = (S.page - 1) * S.per;
  $('#pager').innerHTML = '<span class="info">' + (total ? fmt(T.bc_showing, from + 1, Math.min(from + S.per, total), total) : esc(T.bc_zero_results)) + '</span>' +
    '<button class="pg" data-act="pg" data-p="' + (S.page - 1) + '" ' + (S.page <= 1 ? 'disabled' : '') + '>‹</button>' +
    arr.map(function (x) { return x === '…' ? '<span style="padding:0 4px">…</span>' : '<button class="pg ' + (x === S.page ? 'on' : '') + '" data-act="pg" data-p="' + x + '">' + x + '</button>'; }).join('') +
    '<button class="pg" data-act="pg" data-p="' + (S.page + 1) + '" ' + (S.page >= pages ? 'disabled' : '') + '>›</button>';
  syncBulk();
  var sa = $('#selall'); sa.checked = rows.length > 0 && rows.every(function (c) { return S.sel.has(c.category_id); });
  renderStats();
  $$('#seg button').forEach(function (b) { b.classList.toggle('on', b.dataset.s === S.status); });
}
function syncBulk() {
  var n = S.sel.size, d = $('#b-del');
