    '<div class="f"><label>' + esc(T.bc_display_name) + ' <span class="bdg b">' + esc(T.bc_storefront) + '</span></label><input class="inp" id="a-display" placeholder="' + esc(T.bc_uses_category_name) + '" maxlength="255" autocomplete="off"><small>' + esc(T.bc_display_name_help) + '</small></div>' +
