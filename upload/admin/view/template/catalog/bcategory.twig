/* module additions */
.bpw{background:transparent}
.editor .tb button{padding:3px 9px;border-radius:6px;font-weight:700;color:var(--mute)}
.editor .tb button:hover,.editor .tb button.on{background:#e6ebf6;color:var(--text)}
.editor .src{display:none;width:100%;min-height:190px;border:0;padding:12px;font-family:ui-monospace,Menlo,monospace;font-size:12.5px;outline:0;resize:vertical}
