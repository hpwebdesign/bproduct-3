.chipc.more{background:var(--teal-soft);color:var(--teal);margin-left:4px}
th.xh{color:var(--blue)}
td.c-x mark{background:#ffe9a8;color:inherit;border-radius:3px}
.slugprev{font-size:12px;color:var(--mute);margin-top:4px}
.drawer.narrow{width:min(640px,100vw)}
.addtop{display:flex;gap:14px;align-items:flex-start;margin-bottom:14px}
.addimg.lg{width:88px;height:88px;flex:none}
