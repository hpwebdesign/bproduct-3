function fieldLabel(k) { var f = byKey(FIELDS.map(function (x) { return {k: x[0], l: x[1]}; }), 'k', k); return f ? f.l : k; }
var S = {sort: CFG.sort.split('|')[0], order: CFG.sort.split('|')[1], q: '', status: '', per: CFG.limit, page: 1, sel: new Set(), f: defaultF(), fopen: false, rows: [], total: 0, pages: 1, stats: null, slugEdit: null, flash: null, loaded: false};
