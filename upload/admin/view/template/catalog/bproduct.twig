R.addEventListener('change', function (e) {
  var el = e.target, d = el.dataset;
  if (d.oo !== undefined) { optSync(el); if (DR) markDirty('options'); return; }
  if (d.act === 'tog' && denied('tog')) { el.checked = !el.checked; return; }
  if (d.act === 'tog') { setStatus([+d.id], el.checked ? 1 : 0, el); return; }
  if (d.act === 'selrow') { el.checked ? S.sel.add(+d.id) : S.sel.delete(+d.id); render(); return; }
  if (d.act === 'selall') { S.rows.forEach(function (p) { el.checked ? S.sel.add(p.product_id) : S.sel.delete(p.product_id); }); render(); return; }
  if (d.act === 'per') { S.per = +el.value; S.page = 1; load(); return; }
  if (el.id === 'sortm') { var s = el.value.split('|'); S.sort = s[0]; S.order = s[1]; S.page = 1; load(); return; }
  if (d.fincl !== undefined) { S.f.incl = el.checked; applyFilters(); return; }
  if (d.fstore !== undefined) { S.f.store = el.value; applyFilters(); return; }
  if (d.ffx !== undefined) { S.f.ff[+d.ffx].x = el.checked; applyFilters(); return; }
  if (d.ffv !== undefined && el.tagName === 'SELECT') { S.f.ff[+d.ffv].v = el.value; applyFilters(); return; }
  if (d.ffk !== undefined) { var r = S.f.ff[+d.ffk]; r.k = el.value; r.v = ''; r.x = false; renderPanel(); applyFilters(); var n = $('[data-ffv="' + d.ffk + '"]'); if (n) n.focus(); return; }
  if (DR && el.closest('#drawer')) {
    var sec = secOf(el);
    if (sec === 'seo' && d.seo !== undefined) seoCheck(el);
  }
});

R.addEventListener('input', function (e) {
  var el = e.target, d = el.dataset || {};
  if (el.id === 'q') { S.q = el.value; S.page = 1; loadSoon(); return; }
  if (d.ssq !== undefined) { ssSearch(d.ssq, el.value); return; }
  if (d.fmodel !== undefined) { S.f.model = el.value; debFilter(); return; }
  if (d.ffv !== undefined && el.tagName === 'INPUT') { S.f.ff[+d.ffv].v = el.value; debFilter(); return; }
  if (d.bpq !== undefined) { fillBulkSoon(el.value); return; }
  if (el.hasAttribute && el.hasAttribute('data-slugin')) { slugCheck(el); return; }
  if (d.ac) { acShow(el); return; }
  if (el.id === 'a-name') { $('#a-slug').textContent = '/' + slugify(el.value); markDirty(); return; }
  if (!DR || !el.closest('#drawer')) return;
  if (d.oo !== undefined) { optSync(el); markDirty('options'); return; }
  if (d.at !== undefined) { var a = DR.attrs[+d.at]; if (a) { a.text = a.text || {}; a.text[d.lid] = el.value; } markDirty('attributes'); return; }
  if (d.r) {
    var rule = el.closest('.rule'), v = function (x) { return rule.querySelector('[data-r="' + x + '"]'); };
    if (d.r === 'date_start' || d.r === 'date_end') { var st = ruleState(v('date_start').value, v('date_end').value), b = v('st'); b.className = 'bdg ' + st[1]; b.textContent = st[0]; }
    rule.classList.remove('bad'); var m = rule.querySelector('.rmsg'); m.className = 'rmsg'; m.textContent = '';
  }
  if (el.closest('.editor')) el.closest('.editor').dataset.touched = '1';
  if (el.closest('.lp')) { checkLang(); if (d.k === 'name' || d.k === 'meta_title') headRefresh(); }
  if (d.seo !== undefined) { clearTimeout(seoTimers[d.seo]); seoTimers[d.seo] = setTimeout(function () { seoCheck(el); }, 400); headRefresh(); }
  if (el.matches && el.matches('[data-lnk], [data-chip]')) return;
  if (CFG.barcode.on && d.d === CFG.barcode.source && $('#bc-box') && $('#bc-box').firstChild) bcRefresh();
  markDirty(secOf(el));
});

R.addEventListener('focusin', function (e) {
  var el = e.target;
  if (el.dataset && el.dataset.ac) acShow(el);
});

R.addEventListener('keydown', function (e) {
  var el = e.target, d = el.dataset || {};
  if (e.key === 'Enter') {
    if (el.hasAttribute && el.hasAttribute('data-slugin')) { var b = $('[data-act="slugok"]'); if (b) b.click(); }
    else if (d.ac) { e.preventDefault(); var f = Array.prototype.filter.call(el.parentNode.querySelectorAll('.aci[data-act]'), function (x) { return !x.querySelector('.bdg'); })[0]; if (f) f.click(); }
    else if (DR && DR.mode === 'add' && (el.id === 'a-name' || el.id === 'a-model')) addSave('close');
    else if (d.lnk !== undefined) { e.preventDefault(); var ok = el.parentNode.querySelector('[data-ed="linkok"]'); if (ok) ok.click(); }
  }
});

document.addEventListener('keydown', function (e) {
  if (e.key !== 'Escape' || !host.isConnected) return;
  if ($('.ss.open')) { ssCloseAll(); return; }
  if ($('.acl.on')) { acClose(); return; }
  if ($('#cf').classList.contains('on')) { $('#cf').classList.remove('on'); cfCb = null; return; }
  if (document.querySelector('#modal-image')) return;
  if (DR) { closeDrawer(); return; }
  if (S.slugEdit) { S.slugEdit = null; render(); return; }
  closeFloat();
});
document.addEventListener('click', function (e) {
  if (e.target === host || (e.composedPath && e.composedPath().indexOf(host) >= 0)) return;
  closeFloat(); ssCloseAll(); acClose();
});
document.addEventListener('keydown', function (e) {
  if (!DR || e.altKey || e.shiftKey || !(e.ctrlKey || e.metaKey) || String(e.key).toLowerCase() !== 's') return;
  e.preventDefault();
  var b = $(DR.mode === 'add' ? '[data-act="addsave"][data-mode="close"]' : '[data-act="dsave"]');
  if (b && !b.disabled) b.click();
});
window.addEventListener('beforeunload', function (e) {
  if (DR && isDirty()) { e.preventDefault(); e.returnValue = ''; }
});

