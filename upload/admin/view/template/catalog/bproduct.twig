var edRange = null;
function selNow() { return R.getSelection ? R.getSelection() : document.getSelection(); }
function edRun(btn) {
  var ed = btn.closest('.editor'), ct = ed.querySelector('.ct'), cmd = btn.dataset.ed, row = ed.querySelector('.lnkrow');
  ed.dataset.touched = '1';
  if (cmd === 'src') {
    var src = ed.querySelector('.src');
    if (ed.classList.contains('srcmode')) { ct.innerHTML = src.value; ed.classList.remove('srcmode'); btn.classList.remove('on'); }
    else { src.value = ct.innerHTML; ed.classList.add('srcmode'); btn.classList.add('on'); }
    return;
  }
  if (ed.classList.contains('srcmode')) return;
  if (cmd === 'link') {
    var s = selNow(); edRange = s && s.rangeCount ? s.getRangeAt(0).cloneRange() : null;
    row.style.display = row.style.display === 'none' ? 'flex' : 'none';
    if (row.style.display === 'flex') row.querySelector('input').focus();
    return;
  }
  if (cmd === 'linkok') {
    var url = row.querySelector('input').value.trim();
    row.style.display = 'none'; row.querySelector('input').value = '';
    ct.focus();
    if (edRange) { var s2 = selNow(); s2.removeAllRanges(); s2.addRange(edRange); }
    if (url) document.execCommand('createLink', false, url);
    markDirty('general');
    return;
  }
  if (cmd === 'image') {
    var s3 = selNow(); var rg = s3 && s3.rangeCount ? s3.getRangeAt(0).cloneRange() : null;
    pickImage(function (path) {
      ct.focus();
      if (rg) { var s4 = selNow(); s4.removeAllRanges(); s4.addRange(rg); }
      document.execCommand('insertImage', false, CFG.image_base + path);
      markDirty('general');
    });
    return;
  }
  ct.focus();
  if (cmd === 'headmenu') { var hm = ed.querySelector('.hmenu'); hm.style.display = hm.style.display === 'none' ? 'block' : 'none'; return; }
  var hmenu = ed.querySelector('.hmenu'); if (hmenu) hmenu.style.display = 'none';
  if (cmd.indexOf('fmt:') === 0) document.execCommand('formatBlock', false, '<' + cmd.slice(4) + '>');
  else if (cmd === 'quote') {
    var blk = selNow() && selNow().anchorNode; blk = blk && (blk.nodeType === 3 ? blk.parentNode : blk);
    document.execCommand('formatBlock', false, blk && blk.closest && blk.closest('blockquote') ? '<p>' : '<blockquote>');
  }
  else if (cmd === 'clear') {
    document.execCommand('removeFormat', false, null);
    document.execCommand('unlink', false, null);
    document.execCommand('formatBlock', false, '<p>');
  }
  else document.execCommand(cmd, false, null);
  markDirty('general');
}
function editorValue(ed) {
  return ed.classList.contains('srcmode') ? ed.querySelector('.src').value : ed.querySelector('.ct').innerHTML;
}

