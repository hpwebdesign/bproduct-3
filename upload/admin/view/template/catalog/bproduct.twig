/* ---------- events ---------- */
var MODACTS = ['addopen', 'del', 'bulk-del', 'bulk-clone', 'bulk-en', 'bulk-dis', 'dup', 'slugok', 'bulkpick', 'bppick', 'dsave', 'addsave', 'tog'];
function denied(a) {
  if (CFG.can_modify || MODACTS.indexOf(a) < 0) return false;
  toast(T.error_permission, 'err');
  return true;
}
var imDrag = null;
R.addEventListener('dragstart', function (e) {
  var tr = e.target.closest ? e.target.closest('.imgt tr[draggable]') : null;
  if (!tr) return;
  imDrag = tr;
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', '');
  tr.classList.add('dragging');
});
R.addEventListener('dragover', function (e) {
  if (!imDrag) return;
  e.preventDefault();
  var over = e.target.closest('.imgt tr[draggable]');
  if (!over || over === imDrag) return;
  var r = over.getBoundingClientRect();
  over.parentNode.insertBefore(imDrag, (e.clientY - r.top) > r.height / 2 ? over.nextSibling : over);
});
R.addEventListener('dragend', function () {
  if (!imDrag) return;
  var rows = Array.prototype.slice.call(imDrag.parentNode.children);
  imDrag.classList.remove('dragging');
  imDrag = null;
  var old = DR.im.add, next = rows.map(function (tr) { return old[+tr.dataset.i]; });
  if (next.some(function (x, i) { return x !== old[i]; })) {
    DR.im.add = next.map(function (x, i) { x.sort = String(i); return x; });
    markDirty('images');
  }
  imgPaint();
});

R.addEventListener('click', function (e) {
  var t = e.target;
  if (!t.closest('.ss')) ssCloseAll();
  if (!t.closest('.ac')) acClose();
  if (!t.closest('#menu,#pop,[data-act="menu"],[data-act="bulkpick"]')) closeFloat();
  var ed = t.closest('[data-ed]');
  if (ed) { edRun(ed); return; }
  var el = t.closest('[data-act]');
  if (!el || (el.matches('input') && el.type !== 'button')) return;
  var a = el.dataset.act, id = el.dataset.id ? +el.dataset.id : null, i = el.dataset.i !== undefined ? +el.dataset.i : null;
  if (denied(a)) return;
  switch (a) {
    case 'sort': S.sort = el.dataset.sort; S.order = el.dataset.order; S.page = 1; load(); break;
    case 'stf': S.status = el.dataset.s; S.page = 1; load(); break;
    case 'pg': if (+el.dataset.p >= 1) { S.page = +el.dataset.p; load(); } break;
    case 'reset': resetAll(); break;
    case 'addopen': if (!isDirty() || !DR) openAdd(); break;
    case 'del': { var r = rowById(id); deleteIds([id], r ? r.name : ''); break; }
    case 'bulk-del': deleteIds(Array.from(S.sel)); break;
    case 'bulk-clone': if (S.sel.size) cloneIds(Array.from(S.sel)); break;
    case 'bulk-en': case 'bulk-dis': setStatus(Array.from(S.sel), a === 'bulk-en' ? 1 : 0); break;
    case 'gen-barcode': bcRefresh(); break;
    case 'bc-dl': bcDownload(); break;
    case 'bulk-clear': S.sel.clear(); render(); break;
    case 'menu': openMenu(id, el); break;
    case 'menuclose': case 'popclose': closeFloat(); break;
    case 'sec': closeFloat(); openDrawer(id, el.dataset.sec); break;
    case 'dup': closeFloat(); cloneIds([id]); break;
    case 'fullform': closeFloat(); window.open(CFG.edit_url + id, '_blank'); break;
    case 'storefront': { closeFloat(); var sp = rowById(id); window.open(sp && sp.slug ? CFG.catalog_url + '/' + sp.slug : CFG.storefront_url + id, '_blank'); break; }
    case 'slug': { var p = rowById(id); if (!p) break; if (!p.slug) { slugGenerate(id); break; } S.slugEdit = id; render(); var si = $('[data-slugin]'); if (si) { si.focus(); si.select(); } break; }
    case 'slugno': S.slugEdit = null; render(); break;
    case 'slugok': {
      var inp = $('[data-slugin]'), v = slugify(inp.value), m = $('#slugmsg');
      if (!v) { m.className = 'slugmsg bad'; m.textContent = T.bp_slug_empty; break; }
      saveSlug(id, v, function (ok, msg) {
        if (!ok) { m.className = 'slugmsg bad'; m.textContent = msg; return; }
        S.slugEdit = null; render(); toast(T.bp_slug_updated);
      });
      break;
    }
    case 'slugcopy': { var q = rowById(id); if (q && navigator.clipboard) navigator.clipboard.writeText(CFG.catalog_url + '/' + q.slug); toast(T.bp_slug_copied); break; }
    case 'ftoggle': S.fopen = !S.fopen; syncPanel(); break;
    case 'fedit': focusFilter(el.dataset.k); break;
    case 'fclr': clearFilter(el.dataset.k); break;
    case 'fclrall': case 'freset': clearFilters(); break;
    case 'ffadd': {
      var used = S.f.ff.map(function (r) { return r.k; }), k = FIELDS.map(function (x) { return x[0]; }).filter(function (x) { return used.indexOf(x) < 0; })[0];
      if (k) { S.f.ff.push({k: k, v: '', x: false}); renderPanel(); var n = $('[data-ffv="' + (S.f.ff.length - 1) + '"]'); if (n) n.focus(); }
      break;
    }
    case 'ffrm': S.f.ff.splice(i, 1); renderPanel(); applyFilters(); break;
    case 'ssopen': {
      var w = el.closest('.ss'), was = w.classList.contains('open');
      ssCloseAll();
      if (!was) { w.classList.add('open'); ssFill(el.dataset.ss, ''); var sq = w.querySelector('[data-ssq]'); sq.value = ''; sq.focus(); }
      break;
    }
    case 'sspick': {
      var nm = el.dataset.ss, c = SSCFG[nm], item = el.dataset.id ? byKey(ssCache[nm] || [], 'id', el.dataset.id) : null;
      c.set(item ? {id: item.id, name: item.name} : null); ssLabel(nm); ssCloseAll(); c.after();
      break;
    }
    case 'bulkpick': openBulkPick(el.dataset.kind, el); break;
    case 'bppick': applyBulkPick(+el.dataset.id); break;
    case 'cf-no': $('#cf').classList.remove('on'); cfCb = null; break;
    case 'cf-yes': { $('#cf').classList.remove('on'); var cb = cfCb; cfCb = null; if (cb) cb(); break; }
    /* drawer */
    case 'dclose': closeDrawer(); break;
    case 'dsave': saveDrawer(); break;
    case 'tab': {
