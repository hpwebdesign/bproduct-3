    b('bold', '<b>B</b>', T.bp_ed_bold) + b('italic', '<i>I</i>', T.bp_ed_italic) + b('underline', '<u>U</u>', T.bp_ed_underline) +
    b('quote', '<i class="bi bi-quote"></i>', T.bp_ed_quote) + b('clear', '<i class="bi bi-eraser"></i>', T.bp_ed_clear) +
    b('insertUnorderedList', '<i class="bi bi-list-ul"></i>', T.bp_ed_list) + b('insertOrderedList', '<i class="bi bi-list-ol"></i>', T.bp_ed_list) +
    b('link', '<i class="bi bi-link-45deg"></i>', T.bp_ed_link) + b('unlink', '<i class="bi bi-link-45deg" style="opacity:.5;text-decoration:line-through"></i>', T.bp_ed_unlink) + b('image', '<i class="bi bi-image"></i>', T.bp_ed_image) + b('src', '<i class="bi bi-code-slash"></i>', T.bp_ed_source) +
    '</div><div class="lnkrow" style="display:none;padding:6px;border-bottom:1px solid var(--line);gap:6px"><input class="inp sm" data-lnk placeholder="https://" autocomplete="off"><button type="button" class="btn blue sm" data-ed="linkok">' + esc(T.bp_ok) + '</button></div>' +
    '<div class="ct" contenteditable="true" data-k="description">' + html + '</div><textarea class="src" data-k="descsrc"></textarea></div>';
