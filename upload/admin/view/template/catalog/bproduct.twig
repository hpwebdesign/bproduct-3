{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div id="bp-host"></div>
  </div>
</div>
<script type="application/json" id="bp-config">{{ bp_config }}</script>
<script type="application/json" id="bp-lang">{{ bp_lang }}</script>
<template id="bp-shell"><style>{% verbatim %}
:host{display:block;
  --navy:#14284f;--navy2:#1d3a78;--blue:#2347a8;--blue-soft:#e8eefc;
  --green:#2f855a;--green-soft:#e3f4ea;--amber:#b7791f;--amber-soft:#fdf3dc;
  --red:#c53030;--red-soft:#fde8e8;--teal:#0e7490;--teal-soft:#dcf3f8;--purple:#6d48c9;--purple-soft:#ede7fb;
  --bg:#f5f7fc;--card:#fff;--line:#e3e8f2;--text:#18233f;--mute:#6b7690;--r:14px;
}
*{box-sizing:border-box}
.bpw{font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--text)}
button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}
input,select,textarea{font:inherit;color:inherit}
.wrap{margin:0 auto;padding:4px 0 40px}
svg.i{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}

/* header + stat strip */
.head{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.logo{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,var(--navy2),var(--navy));color:#fff;display:grid;place-items:center;font-weight:700}
.head h1{font-size:20px;margin:0}
.head p{margin:0;color:var(--mute)}
.crumb{margin-left:auto;color:var(--mute);font-size:13px}
.strip{display:flex;flex-wrap:wrap;gap:10px;background:#eef2fb;border-radius:var(--r);padding:10px;margin-bottom:16px}
.strip .st{display:flex;align-items:center;gap:10px;background:#fff;border-radius:999px;padding:6px 18px 6px 6px;box-shadow:0 1px 2px rgba(20,40,90,.06)}
.strip .ico{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;flex:none}
.strip .ico.blue{background:#e3ecfd;color:#2460b8}.strip .ico.green{background:#dff5e8;color:#1f9d57}.strip .ico.grey{background:#ececf1;color:#6b7280}.strip .ico.amber{background:#fff0d4;color:#c98100}
.strip b{font-size:17px;line-height:1.15;display:block;color:var(--text)}
.strip span{font-size:12px;color:var(--mute);white-space:nowrap}

/* generic */
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r)}
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 13px;border-radius:10px;font-weight:600;white-space:nowrap;transition:.15s}
.btn.primary{background:var(--blue);color:#fff}.btn.primary:hover{background:var(--navy2)}
.btn.green{background:var(--green-soft);color:var(--green)}.btn.green:hover{background:#cdebd9}
.btn.amber{background:var(--amber-soft);color:var(--amber)}
.btn.red{background:var(--red-soft);color:var(--red)}.btn.red:hover{background:#fbd3d3}
.btn.blue{background:var(--blue-soft);color:var(--blue)}.btn.blue:hover{background:#d8e3fb}
.btn.ghost{background:#fff;border:1px solid var(--line)}.btn.ghost:hover{background:#f3f6fc}
.btn.solidred{background:var(--red);color:#fff}
.btn.sm{padding:6px 10px;font-size:13px}
.btn.icon{padding:7px 9px}
.bcrow{display:flex;gap:6px;align-items:flex-start}.bcrow .btn{flex:none;padding:8px 11px}
.bcw{margin:-4px 0 14px}.bcb{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#fff}.bcb svg{max-width:100%;height:auto}
.bdg{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;padding:2px 8px;border-radius:99px;white-space:nowrap}
.bdg.g{background:var(--green-soft);color:var(--green)}
.bdg.a{background:var(--amber-soft);color:var(--amber)}
.bdg.b{background:var(--blue-soft);color:var(--blue)}
.bdg.t{background:var(--teal-soft);color:var(--teal)}
.bdg.p{background:var(--purple-soft);color:var(--purple)}
.bdg.r{background:var(--red-soft);color:var(--red)}
.inp{width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:10px;background:#fff;outline:0;transition:.15s}
.inp:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(35,71,168,.12)}
.inp.err{border-color:var(--red);background:#fff8f8}
.inp.sm{padding:6px 8px;font-size:13px}
.errtxt{color:var(--red);font-size:12px;margin-top:3px}
.warn{color:var(--amber);font-size:11px;font-weight:600}
.tg{position:relative;display:inline-block;width:38px;height:22px}
.tg input{opacity:0;width:0;height:0;position:absolute}
.tg i{position:absolute;inset:0;background:#cfd6e6;border-radius:99px;transition:.2s;cursor:pointer}
.tg i:before{content:"";position:absolute;width:16px;height:16px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 2px rgba(0,0,0,.25)}
.tg input:checked+i{background:#4caf6d}
.tg input:checked+i:before{transform:translateX(16px)}
.spin{width:10px;height:10px;border:2px solid var(--blue);border-top-color:transparent;border-radius:50%;animation:sp .7s linear infinite;display:inline-block}
@keyframes sp{to{transform:rotate(360deg)}}

/* quick add */
.qa{padding:14px 16px;margin-bottom:14px;border-left:4px solid var(--blue)}
.qa h3{margin:0 0 10px;font-size:14px;display:flex;align-items:center;gap:8px}
.qa h3 small{font-weight:400;color:var(--mute)}
.qa-grid{display:grid;grid-template-columns:56px 2fr .8fr .8fr .8fr 92px auto;gap:10px;align-items:start}
.qa label{display:block;font-size:11px;color:var(--mute);margin-bottom:3px;font-weight:600;text-transform:uppercase;letter-spacing:.03em}
.qa .slugprev{font-size:12px;color:var(--mute);margin-top:4px}
.qa .tgwrap{height:36px;display:flex;align-items:center;gap:8px}
.addimg{width:56px;height:56px;border:1.5px dashed #b9c4de;border-radius:12px;display:grid;place-items:center;color:var(--mute);background:#f8faff;overflow:hidden;padding:0}
.addimg:hover{border-color:var(--blue);color:var(--blue)}
.addimg img{width:100%;height:100%;object-fit:cover}

/* toolbar + az */
.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.search{position:relative;flex:1;min-width:220px;max-width:420px}
.search svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--mute)}
.search .inp{padding-left:34px;border-radius:99px}
.seg{display:inline-flex;background:#fff;border:1px solid var(--line);border-radius:99px;padding:3px}
.seg button{padding:5px 14px;border-radius:99px;color:var(--mute);font-weight:600}
.seg button.on{background:var(--navy);color:#fff}
.lbar{position:absolute;left:0;right:0;top:0;height:3px;overflow:hidden;border-radius:14px 14px 0 0;opacity:0;transition:opacity .15s;z-index:6;pointer-events:none}
.lbar:after{content:'';position:absolute;top:0;bottom:0;width:35%;background:linear-gradient(90deg,transparent,var(--blue),transparent);animation:lbar 1s linear infinite}
@keyframes lbar{from{left:-35%}to{left:100%}}
#listcard{position:relative}
#listcard table{transition:opacity .15s}
#listcard.loading table,#listcard.loading .pager{opacity:.45;pointer-events:none}
#listcard.loading .lbar{opacity:1}
#listcard.loading:before{content:'';position:fixed;left:50%;top:50%;width:30px;height:30px;margin:-15px 0 0 -15px;border:3px solid #d3dcf1;border-top-color:var(--blue);border-radius:50%;animation:spin .7s linear infinite;z-index:7}
@keyframes spin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.lbar:after,#listcard.loading:before{animation-duration:2s}}
.imgm{position:relative;width:128px;height:128px;border-radius:14px;overflow:hidden;border:1px solid var(--line);display:block;padding:0}
.imgm img{width:100%;height:100%;object-fit:cover;display:block}
.imgm .cam{position:absolute;inset:0;background:rgba(20,40,79,.55);color:#fff;display:grid;place-items:center;opacity:0;transition:.15s}
.imgm:hover .cam,.imgm:focus-visible .cam{opacity:1}
.imgm.empty{border:1.5px dashed #c9d3ea;background:#f9fbfe;color:var(--mute);display:grid;place-items:center;font-weight:600;text-align:center}
.imgt{width:100%;border-collapse:collapse;margin-bottom:10px}
.imgt th{text-align:left;font-size:12px;color:var(--mute);padding:6px 8px;border-bottom:1px solid var(--line)}
.imgt td{padding:8px;border-bottom:1px solid var(--line);vertical-align:middle}
.imgt .imgm{width:60px;height:60px;border-radius:10px}
.imgt .dgh{width:28px;color:var(--mute);cursor:grab}
.imgt tr.dragging{opacity:.45;background:var(--bg)}
.optw{display:grid;grid-template-columns:170px 1fr;gap:16px;align-items:start}
.optl{display:flex;flex-direction:column;gap:3px}
.optl .pill{display:flex;align-items:center;gap:6px;padding:8px 10px;border-radius:10px;font-weight:600;color:var(--mute);cursor:pointer;text-align:left;width:100%}
.optl .pill:hover{background:#eef2fb;color:var(--text)}
.optl .pill.on{background:var(--blue-soft);color:var(--blue)}
.optl .pill span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.optl .pill .rm{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;color:var(--mute);flex:none}
.optl .pill .rm:hover{background:#fde8e8;color:var(--red)}
.optp{display:none}.optp.on{display:block}
.ovr{border:1px solid var(--line);border-radius:12px;padding:10px;margin-bottom:8px;background:#fff}
.ovr .oh{display:flex;gap:8px;margin-bottom:8px}
.ovr .og{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.ovr .og label{display:block;font-size:11.5px;color:var(--mute);font-weight:600;margin-bottom:2px}
.ovr .pf{display:flex;gap:4px}.ovr .pf select{width:52px;flex:none}
.otype{font-size:11px;color:var(--mute);font-weight:600;margin-left:6px}
.acl .ah{padding:6px 12px 2px;font-size:11px;font-weight:700;color:var(--mute);text-transform:uppercase;letter-spacing:.05em;cursor:default}
.dsg{width:100%;border-collapse:collapse}
.dsg th{text-align:left;font-size:12px;color:var(--mute);padding:8px 10px;border-bottom:1px solid var(--line)}
.dsg td{padding:8px 10px;border-bottom:1px solid var(--line)}
@media(max-width:700px){.optw{grid-template-columns:1fr}.ovr .og{grid-template-columns:1fr 1fr}}
.toolbar .tbulk{margin-left:auto;display:flex;gap:6px}
.toolbar .tbulk .btn{display:inline-flex;align-items:center;gap:6px}
.toolbar .tbulk .btn:disabled{opacity:.45;cursor:not-allowed}
.toolbar .sp{display:flex;align-items:center;gap:8px;color:var(--mute)}
.toolbar select{padding:6px 8px;border:1px solid var(--line);border-radius:10px;background:#fff}
.az{display:flex;gap:4px;overflow-x:auto;padding:2px 0 10px;scrollbar-width:thin}
.az button{min-width:34px;padding:5px 6px;border-radius:9px;background:#fff;border:1px solid var(--line);font-weight:700;position:relative;color:var(--text)}
.az button sup{font-size:9px;font-weight:600;color:var(--mute);margin-left:1px}
.az button:hover:not(:disabled){background:var(--blue-soft);border-color:#c9d6f5}
.az button.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.az button.on sup{color:#bcd}
.az button:disabled{opacity:.35;cursor:default}
.az .all{padding:5px 12px}
.bulk{position:sticky;top:8px;z-index:20;display:none;align-items:center;gap:10px;background:var(--navy);color:#fff;padding:9px 14px;border-radius:12px;margin-bottom:10px;box-shadow:0 8px 24px rgba(20,40,79,.3)}
.bulk.on{display:flex;flex-wrap:wrap}
.bulk b{margin-right:6px}
.bulk .btn{background:rgba(255,255,255,.12);color:#fff}
.bulk .btn:hover{background:rgba(255,255,255,.22)}
.bulk .btn.red{background:#fde8e8;color:var(--red)}
.bulk .x{margin-left:auto;opacity:.8}

/* table */
table{width:100%;border-collapse:collapse}
th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--mute);padding:11px 12px;background:#f9fbfe;border-bottom:1px solid var(--line)}
th:first-child{border-top-left-radius:var(--r)}th:last-child{border-top-right-radius:var(--r)}
td{padding:10px 12px;border-bottom:1px solid #edf0f7;vertical-align:middle}
tr.row:hover td{background:#fafcff}
tr.row.sel td{background:#f2f6ff}
tr.row.editing td{background:var(--amber-soft)}
tr.row.dirty td{background:#fdecc0}
tr.row.dirty td:first-child{box-shadow:inset 4px 0 0 var(--amber)}
tr.row.flash td{animation:fl 2.4s ease-out}
@keyframes fl{0%,40%{background:#cdeedb}100%{background:transparent}}
td.num{white-space:nowrap}
.thumb{position:relative;width:52px;height:52px;border-radius:12px;overflow:hidden;border:1px solid var(--line);padding:0;display:block}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb .cam{position:absolute;inset:0;background:rgba(20,40,79,.55);color:#fff;display:grid;place-items:center;opacity:0;transition:.15s}
.thumb:hover .cam{opacity:1}
.thumb .cnt{position:absolute;right:3px;bottom:3px;background:var(--navy);color:#fff;font-size:10px;font-weight:700;padding:0 5px;border-radius:99px}
.pname{font-weight:700;font-size:14px}
.slug{display:inline-flex;align-items:center;gap:6px;margin-top:2px;font-size:12px;color:var(--mute)}
.slug code{font-family:ui-monospace,Menlo,monospace;cursor:text;border-radius:5px;padding:0 3px}
.slug code:hover{background:var(--blue-soft);color:var(--blue)}
.slug .mini{opacity:0;color:var(--mute);padding:1px;transition:.15s}
.slug:hover .mini{opacity:1}
.slug .mini:hover{color:var(--blue)}
.slugedit{display:flex;gap:4px;align-items:center;margin-top:3px}
.slugedit .inp{font-family:ui-monospace,Menlo,monospace;font-size:12px;padding:4px 8px;max-width:260px}
.slugmsg{font-size:12px;margin-top:2px}
.slugmsg.bad{color:var(--red)}.slugmsg.ok{color:var(--green)}
.pe{margin-bottom:6px}.pe:last-child{margin-bottom:0}
.pe label{display:block;font-size:10px;font-weight:700;color:var(--mute);text-transform:uppercase;letter-spacing:.04em;margin-bottom:2px}
.margin{font-size:11px;color:var(--green);font-weight:600}
.margin.low{color:var(--amber)}
.chip{display:inline-flex;gap:5px;align-items:center;padding:4px 9px;border-radius:99px;background:var(--teal-soft);color:var(--teal);font-weight:600;font-size:12px}
.chip:hover{background:#c5ebf3}
.chip.empty{background:#f0f2f8;color:var(--mute)}
.acts{display:flex;gap:6px;justify-content:flex-end;align-items:center}
.split{display:inline-flex;border-radius:10px;overflow:hidden;background:var(--blue-soft)}
.split button{padding:7px 10px;color:var(--blue);font-weight:600;display:inline-flex;align-items:center;gap:6px}
.split button:hover{background:#d3dffa}
.split button+button{border-left:1px solid #cbd8f7;padding:7px 7px}
.btn.sq{width:36px;height:36px;padding:0;justify-content:center}
.mgr{height:36px;padding:0 12px;border-color:#cbd8f7;color:var(--blue)}
.mgr:hover{background:var(--blue-soft)}
.empty{padding:50px 20px;text-align:center;color:var(--mute)}
.empty b{display:block;color:var(--text);font-size:16px;margin-bottom:4px}
.pager{display:flex;align-items:center;gap:6px;padding:12px 14px;flex-wrap:wrap}
.pager .info{color:var(--mute);margin-right:auto}
.pager button.pg{min-width:34px;padding:6px;border-radius:9px;border:1px solid var(--line);background:#fff;font-weight:600}
.pager button.pg.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.pager button.pg:disabled{opacity:.4;cursor:default}

/* floating menu + popover */
#menu,#pop{position:fixed;z-index:1033;display:none;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 14px 40px rgba(20,40,79,.18)}
#menu{width:250px;padding:6px}
#menu.on,#pop.on{display:block}
#menu .grp{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--mute);padding:8px 10px 3px;font-weight:700}
#menu hr{border:0;border-top:1px solid var(--line);margin:5px 0}
#menu button{display:flex;align-items:center;gap:9px;width:100%;text-align:left;padding:7px 10px;border-radius:8px}
#menu button:hover{background:var(--blue-soft);color:var(--blue)}
#menu button .n{margin-left:auto}
#menuBack{display:none}
#pop{width:330px;padding:14px}
#pop h4{margin:0 0 10px;font-size:14px;display:flex;justify-content:space-between;align-items:center}
.grow{display:grid;grid-template-columns:1fr 110px 54px;gap:8px;align-items:center;margin-bottom:8px}
.grow span.m{font-size:12px;font-weight:600;color:var(--green);text-align:right}

/* modal */
.ov{position:fixed;inset:0;background:rgba(15,25,50,.5);display:none;align-items:center;justify-content:center;z-index:1035;padding:16px}
.ov.on{display:flex}
.modal{background:#fff;border-radius:16px;width:100%;max-width:440px;padding:22px;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.modal h3{margin:0 0 6px}
.modal p{margin:0 0 18px;color:var(--mute)}
.modal .row{display:flex;gap:8px;justify-content:flex-end}
.im{max-width:820px;padding:0;overflow:hidden}
.im-h{display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid var(--line)}
.im-h h3{margin:0;font-size:16px}
.im-h small{color:var(--mute)}
.im-h .x{margin-left:auto}
.im-b{display:grid;grid-template-columns:280px 1fr;gap:20px;padding:20px}
.im-main{aspect-ratio:1;border-radius:14px;overflow:hidden;border:1px solid var(--line);position:relative}
.im-main img{width:100%;height:100%;object-fit:cover}
.im-main .tag{position:absolute;left:10px;top:10px}
.im-acts{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.im-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:10px}
.im-t{position:relative;aspect-ratio:1;border-radius:12px;overflow:hidden;border:1px solid var(--line);cursor:grab}
.im-t.over{outline:2px dashed var(--blue)}
.im-t img{width:100%;height:100%;object-fit:cover}
.im-t .ov2{position:absolute;inset:0;background:rgba(20,40,79,.6);display:flex;flex-direction:column;gap:4px;align-items:center;justify-content:center;opacity:0;transition:.15s}
.im-t:hover .ov2{opacity:1}
.im-t .ov2 button{background:#fff;border-radius:7px;padding:3px 8px;font-size:11px;font-weight:700}
.im-add{border:1.5px dashed #b9c4de;display:grid;place-items:center;color:var(--mute);text-align:center;font-size:12px;cursor:pointer;background:#f8faff}
.im-add:hover{border-color:var(--blue);color:var(--blue)}
.im-f{display:flex;gap:8px;align-items:center;padding:14px 20px;border-top:1px solid var(--line);background:#f9fbfe}
.im-f .note{color:var(--mute);font-size:12px;margin-right:auto}

/* drawer */
#drawBack{position:fixed;inset:0;background:rgba(15,25,50,.4);z-index:1031;display:none}
#drawBack.on{display:block}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(860px,100vw);background:#fff;z-index:1032;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .25s,width .2s;box-shadow:-12px 0 40px rgba(20,40,79,.2)}
.drawer.on{transform:none}
.drawer.wide{width:min(980px,100vw)}
.dh{display:flex;gap:12px;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line);border-top:4px solid var(--navy)}
.dh img{width:46px;height:46px;border-radius:10px}
.dh b{display:block;font-size:15px}
.dh small{color:var(--mute);font-family:ui-monospace,Menlo,monospace}
.dh .x{margin-left:auto}
.dm{flex:1;display:flex;min-height:0}
.tabs{display:flex;flex-direction:column;gap:2px;width:210px;flex:none;overflow-y:auto;padding:12px 10px;border-right:1px solid var(--line);background:#f9fbfe}
.tabs button{display:flex;gap:10px;align-items:center;width:100%;text-align:left;padding:9px 11px;border-radius:10px;color:var(--mute);font-weight:600}
.tabs button:hover{background:#eef2fb;color:var(--text)}
.tabs button.on{background:var(--blue-soft);color:var(--blue)}
.tabs .n{margin-left:auto}
.tabs .n,#menu .n{background:var(--green-soft);color:var(--green);font-size:10px;font-weight:700;padding:0 6px;border-radius:99px}
.db{flex:1;overflow:auto;padding:20px}
.sec{display:none}.sec.on{display:block}
.f{margin-bottom:14px}
