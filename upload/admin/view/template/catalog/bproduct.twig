  box.innerHTML = '<div class="aci" style="color:var(--mute);cursor:default">' + esc(T.text_loading) + '</div>'; box.classList.add('on');
  api('ac', {type: type, q: q, exclude: kind === 'related' ? DR.id : ''}).then(function (j) {
