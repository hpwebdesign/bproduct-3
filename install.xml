<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>Bariklabs Quick Product Manager (bproduct)</name>
	<code>bproduct</code>
	<version>1.1.5.7</version>
	<author>Bariklabs</author>
	<link>https://bariklabs.com</link>

	<file path="admin/language/*/common/column_left.php">
		<operation error="skip">
			<search trim="true"><![CDATA[// Text]]></search>
			<add position="after"><![CDATA[
			$_['text_bproduct']   = 'Quick Product Manager';
			]]></add>
		</operation>
	</file>

	<file path="admin/controller/common/column_left.php">
		<operation error="skip">
			<search><![CDATA[$hpwd = array();]]></search>
			<add position="after"><![CDATA[
			if ($this->user->hasPermission('access', 'extension/module/bproduct')) {
				$hpwd[] = array(
				  'name'     => $this->language->get('text_bproduct'),
				  'href'     => $this->url->link('extension/module/bproduct', 'user_token=' . $this->session->data['user_token'], true),
				  'children' => array()
				);
			}
			]]></add>
		</operation>
	</file>
	<file path="admin/controller/catalog/product.php">
		<operation error="skip">
			<search><![CDATA[public function index() {]]></search>
			<add position="after"><![CDATA[
		if ($this->config->get('module_bproduct_status')) {
			return new Action('catalog/bproduct');
		}
]]></add>
		</operation>
		<operation error="skip">
			<search><![CDATA[$data['add'] = $this->url->link('catalog/product/add']]></search>
			<add position="before"><![CDATA[$data['bp_status'] = $this->config->get('module_bproduct_status');
		]]></add>
		</operation>
	</file>

	<file path="admin/view/template/catalog/product_list.twig">
		<operation error="skip">
			<search><![CDATA[<a href="{{ add }}"]]></search>
			<add position="before"><![CDATA[{% if bp_status %}<a href="{{ add|replace({'catalog/product/add': 'catalog/product'}) }}&amp;classic=0" data-toggle="tooltip" title="Quick Product Manager" class="btn btn-default"><i class="fa fa-bolt"></i></a>{% endif %} ]]></add>
		</operation>
	</file>

	<file path="catalog/controller/product/product.php" error="skip">
		<operation error="skip">
			<search><![CDATA[$data['model'] = $product_info['model'];]]></search>
			<add position="after"><![CDATA[
			$data['bp_barcode'] = $this->load->controller('extension/module/bproduct/barcode', $product_info);
			]]></add>
		</operation>
	</file>
	<file path="catalog/view/theme/default/template/product/product.twig" error="skip">
		<operation error="skip">
			<search><![CDATA[<li>{{ text_stock }} {{ stock }}</li>]]></search>
			<add position="after"><![CDATA[{% if bp_barcode %}<li class="bp-barcode-row">{{ bp_barcode }}</li>{% endif %}]]></add>
		</operation>
	</file>
	<file path="catalog/view/theme/barik/template/product/product.twig" error="skip">
		<operation error="skip">
			<search><![CDATA[<li>{{ text_stock }}: <strong>{{ stock }}</strong></li>]]></search>
			<add position="after"><![CDATA[{% if bp_barcode %}<li class="bp-barcode-row">{{ bp_barcode }}</li>{% endif %}]]></add>
		</operation>
	</file>

	<file path="admin/controller/catalog/category.php" error="skip">
		<operation error="skip">
			<search><![CDATA[public function index() {]]></search>
			<add position="after"><![CDATA[
		if ($this->config->get('module_bproduct_status') && $this->config->get('module_bproduct_category_status') && !isset($this->request->get['classic'])) {
			return new Action('catalog/bcategory');
		}
]]></add>
		</operation>
	</file>
	<file path="catalog/model/catalog/category.php" error="skip">
		<operation error="skip">
			<search><![CDATA[public function getCategory($category_id) {]]></search>
			<add position="before"><![CDATA[	public function bproductDisplay($row) {
		if ($row && isset($row['category_id'], $row['name'])) {
			$this->load->model('extension/module/bproduct');

			$display = $this->model_extension_module_bproduct->getDisplayName($row['category_id']);

			if ($display !== '') {
				$row['name'] = $display;
			}
		}

		return $row;
	}

	public function bproductDisplayRows($rows) {
		foreach ($rows as $key => $row) {
			$rows[$key] = $this->bproductDisplay($row);
		}

		return $rows;
	}

	]]></add>
		</operation>
		<operation error="skip">
			<search><![CDATA[return $query->row;]]></search>
			<add position="replace"><![CDATA[return $this->bproductDisplay($query->row);]]></add>
		</operation>
		<operation error="skip">
			<search><![CDATA[return $query->rows;]]></search>
			<add position="replace"><![CDATA[return $this->bproductDisplayRows($query->rows);]]></add>
		</operation>
	</file>
</modification>
